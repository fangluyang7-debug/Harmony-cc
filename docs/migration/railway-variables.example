# Harmony-cc migration template, based on the supplied Zeabur variables, 2026-10-21.
# Fill blank secrets and bucket names in Railway Variables. No credentials are included here.
# Attach the persistent volume at /data and restore the database BEFORE starting the API.
# Use Railway's injected PORT; do not copy an old platform-assigned PORT.
NODE_ENV=production
ALLOW_MOCK_PROVIDERS=false
API_SERVER_HOST=0.0.0.0
API_JSON_BODY_LIMIT=10mb
DATABASE_URL=file:/data/harmony-agent.db

SEARCH_PROVIDER=local_product_pool
PRODUCT_DATA_PROVIDER=local_product_pool
PRODUCT_POOL_RESUME_IMPORT_ON_START=false
PRODUCT_EMBEDDING_KINDS=visual,multimodal
# Retained from the supplied environment; current repository code does not read this key.
PRODUCT_IMAGE_BUCKET_GROUP=demo-assets
PRODUCT_IMPORT_IMAGE_JPEG_QUALITY=88
PRODUCT_IMPORT_IMAGE_TARGET_SIZE=480
IMAGE_EMBEDDING_PREPROCESSOR=none
QUERY_IMAGE_STORE_CROP_IN_COS=true
VISUAL_VERIFY_MAX_CANDIDATES=3

ANN_PROVIDER=sqlite_vec
ANN_EMBEDDING_KIND=visual
QUERY_EMBEDDING_KIND=visual
SEARCH_QUERY_EMBEDDING_KIND=multimodal
EMBEDDING_PROVIDER=volcengine_doubao_vision
EMBEDDING_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL_NAME=doubao-embedding-vision-251215
EMBEDDING_DIMENSION=1024
EMBEDDING_API_KEY=

CLOUD_MODEL_MODE=required
CHAT_PROVIDER=deepseek
CHAT_MODEL_BASE_URL=https://api.deepseek.com
CHAT_MODEL_NAME=deepseek-flash
CHAT_MODEL_API_KEY=
VISION_PROVIDER=volcengine_ark
VISION_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL_NAME=doubao-seed-2-1-lite-260915
VISION_CATEGORY_MODEL_NAME=doubao-seed-2-1-lite-260915
VISION_PROFILE_MODEL_NAME=doubao-seed-2-1-lite-260915
VISION_TAGGING_MODEL_NAME=doubao-seed-2-1-lite-260915
VISION_VERIFY_MODEL_NAME=doubao-seed-2-1-lite-260915
VISION_MODEL_API_KEY=

OBJECT_STORAGE_PROVIDER=tencent_cos
OBJECT_STORAGE_REGION=ap-singapore
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_ACCESS_KEY_SECRET=
# In the supplied configuration all three groups use the same existing COS bucket.
# Fill the original bucket name in EACH field; keep existing object keys intact.
OBJECT_STORAGE_BUCKET_COMPRESSED_RECOGNITION=
OBJECT_STORAGE_BUCKET_DEMO_ASSETS=
OBJECT_STORAGE_BUCKET_ORIGINAL_SOURCE=

PHONE_DISPATCH_EXPERIMENT_ENABLED=true
PHONE_DISPATCH_SHOPPING_DEMO_ENABLED=true
JWT_SECRET=
MAINTENANCE_API_TOKEN=

# Optional browser origin allowlist; native apps do not require CORS.
CORS_ORIGINS=
# These keys were absent from the supplied variables. Keep current off/default behavior.
ARTIFACT_PROTOCOL_ENABLED=false
WORKFLOW_PROTOCOL_ENABLED=false
WORKFLOW_RECOVERY_ENABLED=false
SESSION_REVISION_ENABLED=false
ARTIFACT_GC_ENABLED=false
RUNTIME_DEVICES_JSON=[]
