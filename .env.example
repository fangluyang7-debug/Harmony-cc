# Harmony development/server backend; not a HarmonyOS native process.
NODE_ENV=production
ALLOW_MOCK_PROVIDERS=false
API_SERVER_PORT=3100
API_JSON_BODY_LIMIT=10mb
# Local development only. Zeabur uses file:/data/harmony-agent.db on a mounted /data volume;
# see .env.zeabur.example. A phone never opens this server-side SQLite file directly.
DATABASE_URL=file:./harmony-dev.db
# local_product_pool | marketplace
# local_product_pool: search products imported into the configured database
# marketplace: authorized platform API only
SEARCH_PROVIDER=local_product_pool
PRODUCT_DATA_PROVIDER=local_product_pool
PRODUCT_IMPORT_IMAGE_TARGET_SIZE=480
PRODUCT_IMPORT_IMAGE_JPEG_QUALITY=88
# Keep this false on the public API service; resume imports manually to avoid
# startup memory pressure from stale queued/processing batches.
PRODUCT_POOL_RESUME_IMPORT_ON_START=false
PRODUCT_POOL_RESUME_IMPORT_BATCH_LIMIT=1
# current_ann_then_refine | light_tag_ann_fusion
SEARCH_PIPELINE_MODE=light_tag_ann_fusion
# Initial image search waits at most this long for compact LLM labels before falling back to visual ANN.
SEARCH_INITIAL_DETAILED_PROFILE_WAIT_MS=30000
# Category and lightweight label recognition wait up to 30s before falling back.
SEARCH_CATEGORY_RECOGNITION_TIMEOUT_MS=30000
SEARCH_LIGHTWEIGHT_PROFILE_WAIT_MS=30000
# Background label recognition is aborted after this hard deadline.
SEARCH_DETAILED_PROFILE_TIMEOUT_MS=30000
# Store query crops in object storage so remote vision providers can fetch them.
QUERY_IMAGE_STORE_CROP_IN_COS=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_SECONDS=2592000
MAINTENANCE_API_TOKEN=replace-with-a-long-random-maintenance-token

# Agentic Runtime
# auto = the real development/server host plus configured cloud endpoints.
# harmonyos remains a blocked placeholder until a real device bridge is implemented.
RUNTIME_PLATFORM_ADAPTER=auto
RUNTIME_NETWORK_PROBE_URL=
RUNTIME_NETWORK_PROBE_TIMEOUT_MS=3000
RUNTIME_MINIMUM_PERFORMANCE_SAMPLES=3
RUNTIME_SWITCH_THRESHOLD=0.05
RUNTIME_LOW_BATTERY_PERCENT=20
RUNTIME_HIGH_TEMPERATURE_CELSIUS=75

# Real model providers
# Doubao / Volcengine Ark vision model, used for user image recognition and product tagging.
VISION_PROVIDER=volcengine_ark
VISION_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL_NAME=
VISION_MODEL_API_KEY=
# Optional scene overrides; blank uses VISION_MODEL_NAME. Shared endpoint/key.
# Keep the default inexpensive; reserve the stronger model for verification.
VISION_TAGGING_MODEL_NAME=
VISION_CATEGORY_MODEL_NAME=
VISION_PROFILE_MODEL_NAME=
VISION_VERIFY_MODEL_NAME=

# DeepSeek chat model, used for natural-language filter parsing.
CHAT_PROVIDER=deepseek
CHAT_MODEL_BASE_URL=https://api.deepseek.com
CHAT_MODEL_NAME=
CHAT_MODEL_API_KEY=

# Realtime user image embedding + ANN.
# Cloud runtime must not depend on the local GPU worker.
# Use the configured provider for user image search only after its API is verified.
EMBEDDING_PROVIDER=volcengine_doubao_vision
EMBEDDING_MODEL_NAME=
EMBEDDING_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=

# Offline product image preprocessing only.
# Set these to local_gpu_worker only on the development machine for product-pool rebuild jobs.
IMAGE_EMBEDDING_PREPROCESSOR=none
IMAGE_WORKER_DETECTION_CLASSES=shoe,sneaker,boot,sandal,camera,headphones,earphones,earbuds,headset,watch,smartwatch,cell phone,mobile phone,smartphone,laptop,computer,tablet,keyboard,computer keyboard,computer mouse,mouse,electronics,digital device
IMAGE_WORKER_QUERY_DETECTION_CLASSES=shoe,camera,headphones,smartwatch,mobile phone,laptop,tablet,keyboard,computer mouse,electronics
IMAGE_WORKER_WARMUP_DETECTOR=true
IMAGE_WORKER_DETECTION_CONF=0.08
IMAGE_WORKER_QUERY_DETECTION_CONF=0.02
PRODUCT_EMBEDDING_KINDS=visual,multimodal
ANN_EMBEDDING_KIND=multimodal
QUERY_EMBEDDING_KIND=visual
SEARCH_QUERY_EMBEDDING_KIND=multimodal
LOCAL_IMAGE_WORKER_BASE_URL=
LOCAL_IMAGE_WORKER_TIMEOUT_MS=60000
ANN_PROVIDER=sqlite_vec
ANN_TOP_K=50
ANN_MIN_SCORE=0.68
ANN_SCAN_BATCH_SIZE=500
SEARCH_GLOBAL_CANDIDATE_LIMIT=30
SEARCH_RESULT_MIN_SCORE=0.55
VISUAL_VERIFY_MAX_CANDIDATES=3
VISUAL_VERIFY_CONCURRENCY=10
VISUAL_VERIFY_TIMEOUT_MS=5000
SEARCH_TIMEOUT_MS=12000
SEARCH_EARLY_RESULT_MIN_COUNT=3
QUERY_IMAGE_BBOX_PADDING_RATIO=0.12
QUERY_IMAGE_BBOX_MIN_CONFIDENCE=0.2
QUERY_IMAGE_EMBEDDING_TARGET_SIZE=480
QUERY_IMAGE_CROP_JPEG_QUALITY=88
PRODUCT_IMAGE_BUCKET_GROUP=demo-assets

# Aggregate search provider
AGGREGATE_SEARCH_PROVIDER=
AGGREGATE_SEARCH_API_KEY=
AGGREGATE_SEARCH_API_BASE_URL=

# Marketplace collector/search provider.
# Only authorized platform APIs are accepted. No fixture fallback is enabled.
MARKETPLACE_SEARCH_MODE=official
MARKETPLACE_ENABLED_PLATFORMS=taobao,douyin,pdd,dewu,jd
MARKETPLACE_TAOBAO_API_BASE_URL=
MARKETPLACE_TAOBAO_API_KEY=
MARKETPLACE_DOUYIN_API_BASE_URL=
MARKETPLACE_DOUYIN_API_KEY=
MARKETPLACE_PDD_API_BASE_URL=
MARKETPLACE_PDD_API_KEY=
MARKETPLACE_DEWU_API_BASE_URL=
MARKETPLACE_DEWU_API_KEY=
MARKETPLACE_JD_API_BASE_URL=
MARKETPLACE_JD_API_KEY=

# Object storage
OBJECT_STORAGE_PROVIDER=tencent_cos
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_ACCESS_KEY_SECRET=
OBJECT_STORAGE_BUCKET_COMPRESSED_RECOGNITION=
OBJECT_STORAGE_BUCKET_ORIGINAL_SOURCE=
OBJECT_STORAGE_BUCKET_DEMO_ASSETS=

# Client / test entry
PUBLIC_API_BASE_URL=http://localhost:3100
VITE_API_BASE_URL=http://localhost:3100

# Optional Python worker on the development/server machine, not a native HAP.
IMAGE_WORKER_HOST=127.0.0.1
IMAGE_WORKER_PORT=7801

# Artifact references: apply additive SQLite migration before enabling. Default remains legacy assetId.
ARTIFACT_PROTOCOL_ENABLED=false

# Independent architecture rollout switches. Enable only after additive migrations.
WORKFLOW_PROTOCOL_ENABLED=false
WORKFLOW_RECOVERY_ENABLED=false
SESSION_REVISION_ENABLED=false
# Explicit version pins restart compatibility; empty disables reuse across process restarts.
SHOPPING_PIPELINE_VERSION=
# Trusted operator configuration, no public device discovery. Tokens live in separate env vars.
RUNTIME_DEVICES_JSON=[]
# Default denies remote dispatch, including when calibration evidence is absent.
PLACEMENT_POLICY_JSON={"mode":"OBSERVE","policyVersion":"placement-v1","expiresAt":0,"killSwitch":true,"allowedDevices":[],"allowedCapabilities":[],"sampleCount":0,"minimumSamples":30,"qualityPassed":false,"nonInferiorityPassed":false,"failureRate":0,"maximumFailureRate":0.05,"cohortAllowed":false}

# Marks expired unpinned artifacts; does not delete business-owned COS images.
ARTIFACT_GC_ENABLED=false
