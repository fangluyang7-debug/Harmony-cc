generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("COORDINATOR_DATABASE_URL")
}

model CoordinatorState {
  id    String @id
  epoch Int
}

model DisplaySession {
  id String @id
  groupId String
  sourceHolderId String
  viewerHolderId String
  state String
  viewVersion Int @default(0)
  shownVersion Int @default(0)
  content String?
  expiresAt BigInt
  @@index([groupId, viewerHolderId, state])
}

model ChannelInbox {
  id String @id
  digest String
  done Boolean
}

model ChannelCursor {
  id String @id
  sequence Int
}

model Workflow {
  id String @id
  groupId String
  planRevision Int
  state String
}

model Node {
  primaryAttemptId String?
  backupAttemptId String?
  winnerAttemptId String?
  id String @id
  workflowId String
  currentAttemptId String?
  state String
}

model Attempt {
  recoveryEstimateJson String?
  id String @id
  groupId String
  workflowId String
  nodeId String
  executionDigest String
  state String
  holderInstanceId String
  recordJson String?
  taskJson String
  offerJson String?
  rejectionJson String?
  yieldJson String?
}

model Outbox {
  id String @id
  sequence Int
  groupId String
  attemptId String
  kind String
  epoch Int
  messageJson String
  acked Boolean @default(false)
  superseded Boolean @default(false)
  deliveryCount Int @default(0)
}

model DispatchSequence {
  id String @id
  value Int
}

model Receipt {
  id String @id
  attemptId String
  recordJson String
  committed Boolean @default(false)
}

model Group {
  id String @id
  groupId String
  revision Int
  metadataJson String
}

model Principal {
  id String @id
  groupId String
  revision Int
  metadataJson String
}

model AppInstance {
  id String @id
  groupId String
  revision Int
  metadataJson String
}

model Device {
  id String @id
  groupId String
  revision Int
  metadataJson String
}

model DeviceInstance {
  id String @id
  groupId String
  revision Int
  metadataJson String
}

model Target {
  id String @id
  groupId String
  revision Int
  metadataJson String
}

model Allotment {
  id String @id
  groupId String
  revision Int
  metadataJson String
}

model Credential {
  id String @id
  groupId String
  holderInstanceId String @default("")
  tokenHash String? @unique
  revoked Boolean @default(false)
  revision Int
  metadataJson String
}

model Invite {
  id String @id
  groupId String
  revision Int
  metadataJson String
}

model TraceSpan {
  id String @id
  groupId String
  revision Int
  metadataJson String
}

model CostObservation {
  id String @id
  groupId String
  revision Int
  metadataJson String
}

model CalibrationJob {
  id String @id
  groupId String
  revision Int
  metadataJson String
}

model CapabilityState {
  id String @id
  groupId String
  revision Int
  metadataJson String
}

model EvaluationDispatch {
  id String @id
  groupId String
  holderInstanceId String
  deviceId String
  epoch Int
  state String
  expiresAt Float
  workJson String
  resultJson String?
  @@index([groupId, holderInstanceId, state])
}

model CpuJob {
  readyWaitJson String?
  id String @id
  groupId String
  principalId String
  sourceHolderId String
  state String
  metadataJson String
  @@index([groupId, principalId])
}

model ConsoleApp {
  id String @id
  groupId String
  principalId String
  holderInstanceId String
  appId String
  appInstanceId String
  @@unique([groupId, principalId, holderInstanceId])
}

model RegisteredApp {
  batchWeight Int @default(1)
  batchService Float @default(0)
  id String @id
  groupId String
  principalId String
  label String
  contractsJson String
  resourcesJson String
  maxConcurrent Int
  @@unique([groupId, principalId, label])
}

model RegisteredInstallation {
  id String @id
  appId String
  groupId String
  principalId String
  deviceId String
  holderInstanceId String @unique
  state String
  secretHash String?
  expiresAt Float
  offlineJson String
  onlineJson String
  @@index([deviceId])
}

model AppJobReservation {
  id String @id
  appId String
  groupId String
  principalId String
  appInstanceId String
  resourcesJson String
  deadlineAt Float
  @@index([groupId, principalId, appId])
}

model SpaceUser {
  id String @id
  account String @unique
  name String
  password String
}
model SpaceSession {
  id String @id
  userId String
  expiresAt Float
}
model TeamSpace {
  id String @id
  name String
  createdAt Float
}
model SpaceMember {
  id String @id
  spaceId String
  userId String
  role String
  joinedAt Float
  @@unique([spaceId, userId])
}
model SpaceInvite {
  id String @id
  spaceId String
  role String
  expiresAt Float
  revoked Boolean @default(false)
}
model SpaceDevice {
  id String @id
  spaceId String
  userId String
  holderId String @unique
  name String
  settingsJson String
  createdAt Float
  @@index([spaceId])
}

model SdkWorkflowJob {
  id String @id
  groupId String
  sourceHolderId String
  state String
  metadataJson String
  @@index([groupId, state])
}

model DataEndpoint {
  id String @id
  groupId String
  holderInstanceId String
  credentialId String
  coordinatorEpoch Int
  metadataJson String
  @@unique([groupId, holderInstanceId])
}

model TransferAuthorization {
  id String @id
  groupId String
  attemptId String
  endpointId String
  requesterCredentialId String
  state String
  expiresAt Float
  metadataJson String
  @@index([groupId, attemptId])
  @@index([expiresAt])
}

model DataReplica {
  id String @id
  groupId String
  endpointId String
  metadataJson String
  @@index([groupId, endpointId])
}

model PeerNetwork {
  id String @id
  groupId String
  holderInstanceId String
  credentialId String
  metadataJson String
  @@unique([groupId, holderInstanceId])
}

model BatchReadyJob {
  priority String @default("REMOTE_BATCH")
  id String @id
  groupId String
  appId String
  peerJson String
  queuedAt Float
  deadlineAt Float
  reason String
  @@index([groupId, queuedAt])
}

model BatchCharge {
  id String @id
  appId String
  estimatedMs Float
  rate Float
  actualMs Float?
}
