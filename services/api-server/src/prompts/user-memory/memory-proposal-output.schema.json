{
  "version": "user-memory-proposal-output-v1",
  "type": "object",
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["blockType", "scope", "payload", "reason", "confidence", "sensitivity"],
        "properties": {
          "blockType": {
            "enum": [
              "identity_basic",
              "body_measurements",
              "size_profile",
              "shopping_preferences",
              "platform_preferences",
              "brand_store_preferences",
              "category_preferences",
              "delivery_preferences",
              "interaction_preferences"
            ]
          },
          "scope": { "type": "string" },
          "payload": { "type": "object" },
          "reason": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sensitivity": { "enum": ["low", "medium", "high"] }
        }
      }
    }
  }
}
