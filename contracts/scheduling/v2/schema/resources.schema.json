            {
              "type": "null"
            }
          ]
        },
        "holderInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "ledgerEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "coordinatorEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "base": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceAmount"
          },
          "maxItems": 32,
          "minItems": 0
        },
        "extra": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceAmount"
          },
          "maxItems": 32,
          "minItems": 0
        },
        "leaseRequestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "leaseMs": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300000
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/=]{32,2048}$"
        }
      },
