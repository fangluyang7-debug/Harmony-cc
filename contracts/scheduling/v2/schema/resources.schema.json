        "foreground": {
          "$ref": "#/definitions/StateSample"
        },
        "charging": {
          "$ref": "#/definitions/StateSample"
        },
        "powerSave": {
          "$ref": "#/definitions/StateSample"
        },
        "battery": {
          "$ref": "#/definitions/NumericSample"
        },
        "temperature": {
          "$ref": "#/definitions/NumericSample"
        },
        "pools": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Pool"
          },
          "maxItems": 32,
          "minItems": 1
        },
        "executors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Executor"
          },
          "maxItems": 64,
          "minItems": 0
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Link"
          },
          "maxItems": 128,
          "minItems": 0
        },
        "credits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Credit"
          },
          "maxItems": 3,
          "minItems": 3
        }
