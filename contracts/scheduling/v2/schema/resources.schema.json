{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:scheduling:v2:resources",
  "definitions": {
    "NumericSample": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "MEASURED",
            "PRIOR",
            "UNKNOWN",
            "SIMULATED"
          ]
        },
        "sampledAt": {
          "type": "number",
          "minimum": 0
        },
        "ttlMs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "value",
        "source",
        "sampledAt",
        "ttlMs",
        "unit"
      ],
      "additionalProperties": false
    },
    "StateSample": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "MEASURED",
            "PRIOR",
            "UNKNOWN",
            "SIMULATED"
          ]
        },
        "sampledAt": {
          "type": "number",
          "minimum": 0
        },
        "ttlMs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "const": "state"
        }
      },
      "required": [
        "value",
        "source",
        "sampledAt",
        "ttlMs",
        "unit"
      ],
      "additionalProperties": false
    },
    "ResourceAmount": {
      "type": "object",
      "properties": {
        "resourcePoolId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "resourcePoolId",
        "amount"
      ],
      "additionalProperties": false
    },
    "Pool": {
      "type": "object",
      "properties": {
        "resourcePoolId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "kind": {
          "enum": [
            "CPU_SLOTS",
            "RAM_BYTES",
            "GPU_SLOTS",
            "VRAM_BYTES",
            "TRANSFER_SLOTS"
          ]
        },
        "exclusive": {
          "type": "boolean"
        },
        "total": {
          "$ref": "#/definitions/NumericSample"
        },
        "ownerReserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contributionLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "admissionLimit": {
          "$ref": "#/definitions/NumericSample"
        },
        "occupied": {
          "$ref": "#/definitions/NumericSample"
        },
        "draining": {
          "type": "boolean"
        },
        "drainMs": {
          "$ref": "#/definitions/NumericSample"
        }
      },
      "required": [
        "resourcePoolId",
        "kind",
        "exclusive",
        "total",
        "ownerReserved",
        "contributionLimit",
        "admissionLimit",
        "occupied",
        "draining",
        "drainMs"
      ],
      "additionalProperties": false
    },
    "ModelManifest": {
      "type": "object",
      "properties": {
        "modelId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "weightsHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preprocessVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "embeddingKind": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "dimension": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "dtype": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "normalization": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "modelId",
        "version",
        "weightsHash",
        "preprocessVersion",
        "embeddingKind",
        "dimension",
        "dtype",
        "normalization"
      ],
      "additionalProperties": false
    },
    "ExecutionConfig": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "quality": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "id",
        "threads",
        "batchSize",
        "quality"
      ],
      "additionalProperties": false
    },
    "Executor": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "urn:scheduling:v2#/definitions/Target"
        },
        "contract": {
          "$ref": "urn:scheduling:v2#/definitions/TaskContract"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelManifest"
            },
            {
              "type": "null"
            }
          ]
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceAmount"
          },
          "maxItems": 32,
          "minItems": 1
        },
        "configurations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExecutionConfig"
          },
          "maxItems": 64,
          "minItems": 1
        },
        "compute": {
          "$ref": "#/definitions/NumericSample"
        },
        "queue": {
          "$ref": "#/definitions/NumericSample"
        },
        "cold": {
          "$ref": "#/definitions/NumericSample"
        },
        "publish": {
          "$ref": "#/definitions/NumericSample"
        },
        "uncertainty": {
          "$ref": "#/definitions/NumericSample"
        }
      },
      "required": [
        "target",
        "contract",
        "model",
        "resources",
        "configurations",
        "compute",
        "queue",
        "cold",
        "publish",
        "uncertainty"
      ],
      "additionalProperties": false
    },
    "Link": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "networkEpoch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "via": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixedMs": {
          "$ref": "#/definitions/NumericSample"
        },
        "bytesPerSecond": {
          "$ref": "#/definitions/NumericSample"
        },
        "metered": {
          "type": "boolean"
        }
      },
      "required": [
        "from",
        "to",
        "networkEpoch",
        "via",
        "fixedMs",
        "bytesPerSecond",
        "metered"
      ],
      "additionalProperties": false
    },
    "Credit": {
      "type": "object",
      "properties": {
        "priority": {
          "enum": [
            "ORIGIN_INTERACTIVE",
            "REMOTE_INTERACTIVE",
            "REMOTE_BATCH"
          ]
        },
        "slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        }
      },
      "required": [
        "priority",
        "slots"
      ],
      "additionalProperties": false
    },
    "DeviceProfile": {
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "deviceInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "holderInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "ledgerEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
