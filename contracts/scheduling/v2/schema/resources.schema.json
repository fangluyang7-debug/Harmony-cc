        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "domain": {
          "enum": [
            "REAL",
            "SIMULATED"
          ]
        },
        "ownerActivity": {
          "$ref": "#/definitions/StateSample"
