        "deviceId",
        "deviceInstanceId",
        "holderInstanceId",
        "ledgerEpoch",
        "sequence",
        "domain",
        "ownerActivity",
        "foreground",
        "charging",
        "powerSave",
        "battery",
        "temperature",
        "pools",
        "executors",
        "links",
        "credits"
      ],
      "additionalProperties": false
