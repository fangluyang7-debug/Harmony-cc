          "maximum": 9007199254740991
        },
        "occupied": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceAmount"
          },
          "maxItems": 32,
          "minItems": 0
        }
      },
      "required": [
        "allotmentId",
        "holderInstanceId",
        "ledgerEpoch",
        "coordinatorEpoch",
        "version",
        "persisted",
        "settlementSeq",
        "occupied"
      ],
      "additionalProperties": false
