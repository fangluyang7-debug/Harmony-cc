        "allotmentId",
        "groupId",
        "deviceId",
        "appInstanceId",
        "holderInstanceId",
        "ledgerEpoch",
        "coordinatorEpoch",
        "version",
        "base",
        "extra",
        "leaseRequestId",
        "leaseMs",
        "signature"
