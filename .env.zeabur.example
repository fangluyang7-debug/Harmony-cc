# Copy these values into the Zeabur API service environment (not into Git or a phone app).
# Mount a persistent volume at /data before starting the service.
NODE_ENV=production
ALLOW_MOCK_PROVIDERS=false
DATABASE_URL=file:/data/harmony-agent.db
# Zeabur injects PORT; bind on every container interface so its gateway can reach the API.
API_SERVER_HOST=0.0.0.0
# Zeabur injects PORT. Do not override it with the local API_SERVER_PORT value.
SEARCH_PROVIDER=local_product_pool
PRODUCT_DATA_PROVIDER=local_product_pool
PRODUCT_POOL_RESUME_IMPORT_ON_START=false
IMAGE_EMBEDDING_PREPROCESSOR=none
PRODUCT_IMPORT_IMAGE_TARGET_SIZE=480
PRODUCT_IMPORT_IMAGE_JPEG_QUALITY=88
PRODUCT_EMBEDDING_KINDS=visual,multimodal
ANN_EMBEDDING_KIND=visual
QUERY_EMBEDDING_KIND=visual
SEARCH_QUERY_EMBEDDING_KIND=multimodal
API_JSON_BODY_LIMIT=10mb
ANN_PROVIDER=sqlite_vec
QUERY_IMAGE_STORE_CROP_IN_COS=true
# Optional comma-separated browser origins. Native apps do not need CORS.
CORS_ORIGINS=

# Existing server-side COS adapter. Keep credentials only in Zeabur secret variables.
OBJECT_STORAGE_PROVIDER=tencent_cos
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_REQUEST_TIMEOUT_MS=15000
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_ACCESS_KEY_SECRET=
OBJECT_STORAGE_BUCKET_COMPRESSED_RECOGNITION=
OBJECT_STORAGE_BUCKET_ORIGINAL_SOURCE=
OBJECT_STORAGE_BUCKET_DEMO_ASSETS=

# Configure the real providers used by the selected workflows.
# Set deferred to verify infrastructure without calling models; shopping stays blocked.
CLOUD_MODEL_MODE=required
VISION_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_PROVIDER=volcengine_ark
VISION_MODEL_NAME=
VISION_MODEL_API_KEY=
# Optional scene overrides; blank uses VISION_MODEL_NAME. Shared endpoint/key.
VISION_TAGGING_MODEL_NAME=
VISION_CATEGORY_MODEL_NAME=
VISION_PROFILE_MODEL_NAME=
VISION_VERIFY_MODEL_NAME=
EMBEDDING_PROVIDER=volcengine_doubao_vision
EMBEDDING_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL_NAME=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
CHAT_MODEL_BASE_URL=https://api.deepseek.com
CHAT_PROVIDER=deepseek
CHAT_MODEL_NAME=
CHAT_MODEL_API_KEY=
JWT_SECRET=
MAINTENANCE_API_TOKEN=

# Artifact references: apply additive SQLite migration before enabling. Default remains legacy assetId.
ARTIFACT_PROTOCOL_ENABLED=false

# Independent architecture rollout switches. Enable only after additive migrations.
WORKFLOW_PROTOCOL_ENABLED=false
WORKFLOW_RECOVERY_ENABLED=false
SESSION_REVISION_ENABLED=false
# Explicit version pins restart compatibility; empty disables reuse across process restarts.
SHOPPING_PIPELINE_VERSION=
# Trusted operator configuration, no public device discovery. Tokens live in separate env vars.
RUNTIME_DEVICES_JSON=[]
# Default denies remote dispatch, including when calibration evidence is absent.
PLACEMENT_POLICY_JSON={"mode":"OBSERVE","policyVersion":"placement-v1","expiresAt":0,"killSwitch":true,"allowedDevices":[],"allowedCapabilities":[],"sampleCount":0,"minimumSamples":30,"qualityPassed":false,"nonInferiorityPassed":false,"failureRate":0,"maximumFailureRate":0.05,"cohortAllowed":false}

# Marks expired unpinned artifacts; does not delete business-owned COS images.
ARTIFACT_GC_ENABLED=false
